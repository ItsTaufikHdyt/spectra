# =====================================================================
# .gitignore — Digital Twin Kota Bontang (spectra)
# Catatan: jangan pakai prefix "./" (tidak dikenali Git).
# Folder data memakai pola `<folder>/**` + pengecualian direktori/README/.gitkeep:
# Git tidak bisa mengecualikan berkas di dalam direktori yang di-ignore, jadi isi di-ignore, bukan direktorinya.
# Panduan tiap folder data ada di README.md folder itu (lihat README.md di root).
# =====================================================================

# --- Lingkungan & rahasia (JANGAN di-commit) ---
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
.claude/settings.local.json

# --- Editor & OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Log & temporary ---
*.log
npm-debug.log*
tmp/
.tmp/
.cache/
.playwright-mcp/

# --- Frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.local
coverage/
# Aset 3D dan GeoJSON salinan dev (sumber kebenaran: data-pipeline/processed/; isi lewat 04_build_master.py --sync dan sync_geojson.py)
frontend/public/tiles/**
!frontend/public/tiles/**/
!frontend/public/tiles/README.md
!frontend/public/tiles/.gitkeep
frontend/public/geojson/**
!frontend/public/geojson/**/
!frontend/public/geojson/README.md
!frontend/public/geojson/.gitkeep

# --- Backend (Python, FastAPI) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Data pipeline: data besar atau turunan, JANGAN di-commit ---
# Dilacak: scripts/, db/, docker/, config/, schemas/, reports/ (kecuali PNG uji tampil), README.md, dan .gitkeep.
data-pipeline/raw/**
!data-pipeline/raw/**/
!data-pipeline/raw/README.md
!data-pipeline/raw/**/README.md
!data-pipeline/raw/.gitkeep
data-pipeline/processed/**
!data-pipeline/processed/**/
!data-pipeline/processed/README.md
!data-pipeline/processed/**/README.md
!data-pipeline/processed/.gitkeep
# Cadangan database (pg_dump): berisi data per bangunan
data-pipeline/backups/**
!data-pipeline/backups/README.md
!data-pipeline/backups/.gitkeep
# Tangkapan layar uji tampil (log JSON dan README tetap dilacak)
data-pipeline/reports/uji_tampil_*/*.png

# --- Format data geospasial, 3D, dan basis data berukuran besar (di mana pun) ---
*.city.json
*.city.jsonl
*.gml
*.gfs
*.glb
*.b3dm
*.tif
*.tiff
*.tfw
*.terrain
*.las
*.laz
*.gpkg
*.shp
*.dbf
*.shx
*.prj
*.mbtiles
*.dump
*.sql.gz
*.sqlite

# --- Docker volume lokal (PostGIS / GeoServer / MinIO) ---
docker-data/
pgdata/
minio-data/
geoserver-data/
