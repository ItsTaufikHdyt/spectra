# Salin ke backend/.env (ter-ignore git). Jangan commit nilai asli.
# Kunci NASA FIRMS (gratis): daftar di https://firms.modaps.eosdis.nasa.gov/api/map_key/ lalu tempel di bawah.
# Tanpa kunci, kartu Hotspot menampilkan "belum dikonfigurasi"; kartu lain tetap jalan.
FIRMS_MAP_KEY=ganti_dengan_map_key
